# Frontend environment variables (Vite). Copy this file to `.env` and fill
# in real values locally - never commit `.env` or a real DSN/API key.
#
# Backend (Python) environment variables live in backend/.env - see
# backend/README.md.

# Base URL of the Python backend API (backend/). Optional in dev (defaults
# to http://localhost:8000); required for production builds.
VITE_API_BASE_URL=""

# PostHog product analytics (src/analytics/posthogInit.ts). Optional -
# analytics stays disabled when unset.
VITE_POSTHOG_API_KEY=""
VITE_POSTHOG_API_HOST=""

# Sentry error tracking (src/errors/sentryInit.ts). Optional - Sentry
# stays disabled (and is tree-shaken out of the production bundle) when
# unset. Create a project at https://sentry.io and paste its DSN here;
# never track private Instagram export/relationship data through it (see
# .opencode/skills/project-context/SKILL.md).
VITE_SENTRY_DSN=""

# EmailJS, used by the support form (src/features/support). Required for
# the support form to actually send messages.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
